# Environment mode: production | debug
NODE_ENV=production

# Server port (4000 production, 4001 debug)
PORT=4000

# Database (localhost — same host as PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pi
DB_USER=user
DB_PASSWORD=changeme
DB_MAX_CONNECTIONS=10

# TLS certificates (Let's Encrypt)
TLS_KEY_PATH=/etc/letsencrypt/live/kilde27.hopto.org/privkey.pem
TLS_CERT_PATH=/etc/letsencrypt/live/kilde27.hopto.org/fullchain.pem

# Intervals (ms)
CURRENT_STATE_POLL_INTERVAL=2000
SSE_BROADCAST_INTERVAL=5000

# Staleness threshold (ms) — mark sensor stale if not updated within this time
STALE_AFTER_MS=15000

# Memory limit (MB) — triggers graceful restart if exceeded
MEMORY_LIMIT_MB=512
