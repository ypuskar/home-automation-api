# Server
PORT=4001
NODE_ENV=production

# Database (localhost — same host as PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pi
DB_USER=user
DB_PASSWORD=changeme
DB_MAX_CONNECTIONS=10

# TLS
TLS_KEY_PATH=/etc/letsencrypt/live/kilde27.hopto.org/privkey.pem
TLS_CERT_PATH=/etc/letsencrypt/live/kilde27.hopto.org/fullchain.pem

# Intervals (ms)
CURRENT_STATE_POLL_INTERVAL=2000
SSE_BROADCAST_INTERVAL=5000
STALE_AFTER_MS=15000

# Memory limit (MB)
MEMORY_LIMIT_MB=512
