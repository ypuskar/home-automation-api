{
  "name": "@home-automation/backend",
  "version": "1.0.0",
  "description": "Home automation API backend - Fastify, SSE, historical queries",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "deploy": "tsc && sudo systemctl restart home-automation-api.service",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.2",
    "@home-automation/shared-types": "workspace:*",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pino": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "fast-check": "^3.23.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
